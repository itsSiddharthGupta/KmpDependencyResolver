<idea-plugin>
  <id>com.kmpdependencyresolver</id>
  <name>KMP Dependency Resolver</name>
  <vendor url="https://github.com/itsSiddharthGupta">itsSiddharthGupta</vendor>
  <description><![CDATA[
    Discover KMP, Compose Multiplatform, and platform-specific dependencies; copy declarations or safely preview and apply Kotlin DSL plus version-catalog changes.
  ]]></description>
  <change-notes><![CDATA[
    <p>Initial 0.1.0 release with multi-provider search, target evidence, four Copy formats, and atomic Add with native diff preview.</p>
  ]]></change-notes>
  <idea-version since-build="252" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.gradle</depends>
  <depends>org.jetbrains.kotlin</depends>
  <depends optional="true" config-file="toml-support.xml">org.toml.lang</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationConfigurable parentId="tools"
                             displayName="KMP Dependency Resolver"
                             instance="com.kmpdependencyresolver.plugin.settings.ResolverConfigurable"/>
    <toolWindow id="KMP Dependencies"
                anchor="right"
                factoryClass="com.kmpdependencyresolver.plugin.ui.DependencyToolWindowFactory"/>
    <notificationGroup id="KMP Dependency Resolver" displayType="BALLOON"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
</idea-plugin>
